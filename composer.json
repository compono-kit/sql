{
  "name": "compono-kit/sql",
  "description": "Tiny sql library and pdo wrapper",
  "license": "MIT",
  "authors": [
    {
      "name": "Benjamin Bruska",
      "email": "benjamin.bruska@your-coder.de"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "suggest": {
    "ext-pdo_mysql": "Required for MySqlManager and DefaultSqlManagerConfig"
  },
  "autoload": {
    "psr-4": {
      "ComponoKit\Sql\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ComponoKit\Sql\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c build/phpunit.xml"
  }
}
