{
  "name": "compono-kit/sql",
  "description": "Tiny sql library and pdo wrapper",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "proprietary",
  "authors": [
    {
      "name": "Benjamin Bruska",
      "email": "benjamin.bruska@your-coder.de"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0.0"
  },
  "autoload": {
    "psr-4": {
